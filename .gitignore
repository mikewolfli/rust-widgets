# Rust build artifacts
/target
**/*.rs.bk
**/*.rlib
**/target

# Java bindings build output (`javac` writes .class here; it is not source).
bindings/java/build/
**/*.class

# Windows SDK / MSVC download caches (cargo-xwin). These are tens of MB of
# downloaded .msi/.cab/.vsix blobs, not source; committing them bloats history.
.xwin-cache/

# IDE/Editor files
.idea/
*.iml
.vscode/.DS_Store
*.swp
*.swo
*~
*.orig

# OS files
.DS_Store
Thumbs.db
Desktop.ini
*.o
*.so
*.dylib
*.exe
*.dll

# Python virtual environment
.venv/
__pycache__/
*.pyc
*.pyo

# Environment files
.env
.env.local
.ruff_cache/
.pair_preview/
.tmp_shots/
.shotcheck/

# Build outputs
**/*.exp
**/*.lib
**/pkg/

# Coverage artifacts
*.profraw
*.profdata
*.gcov
*.gcda
*.gcno
lcov.info
coverage/
demo/control/target
demo/code_editor/target
demo/finance/target

# Test outputs
**/test_output/

# mdBook build output (`mdbook build` in cookbook/{en,zh-CN,zh-TW})
#
# Generated HTML from the Markdown sources; the sources are the artefact and are
# verified by `tools/check_cookbook.sh`, so the rendered copy must not be committed.
cookbook/*/book/

# Stray lint/build dumps
clippy_output.txt
# `rustc`'s default output name when it is invoked without `-o`. One such file
# (a 4.5 MB Linux ELF) had been committed by accident and then sat in the tree as
# a hashed input to every gate, so the name is ignored rather than re-committed.
rust_out
